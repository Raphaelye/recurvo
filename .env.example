# Copy to .env and fill in. .env is not tracked by git.
# Only EXPO_PUBLIC_ variables reach the app, and they are visible in the bundle,
# so only publishable keys go here. Secret keys live in Supabase.

# Clerk dashboard > API keys (pk_...). Required: the app won't start without it.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Logo.dev dashboard > API keys (pk_...). Optional: without it, service chips show no logos.
EXPO_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=

# PostHog (EU cloud) > Project settings > Project API key (phc_...). Optional:
# without it, no analytics are sent. Development builds never send.
EXPO_PUBLIC_POSTHOG_KEY=

# Supabase dashboard > Project Settings > API keys. The project URL and the
# publishable key (sb_publishable_...), never the secret key. Required: the app
# saves every account's data there and won't start without them.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

{
  "expo": {
    "name": "recurvo",
    "slug": "recurvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "recurvo",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/logo.png",
          "imageWidth": 112
        }
      ],
      "expo-image",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Recurvo uses Face ID to unlock the app when App lock is on."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Recurvo uses your photos to set your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
